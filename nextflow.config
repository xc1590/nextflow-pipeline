//  this is process to provide multiple CPUs 
process {
    withLabel: process_high {
        cpus = 4
    }
    withLabel: process_medium {
        cpus = 2
    }
    withLabel: process_low {
        cpus = 1
    }

}

// this is to enable docker and conda profiles
profiles {
    docker {
        docker.enabled = true
    }
    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
    }
}

// this is to provide input and output parameters
params {
    input  = "data/samplesheet.csv"
    outdir = "results"
}